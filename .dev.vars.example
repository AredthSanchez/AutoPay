# Example settings for running the server on your computer. Put real values in .dev.vars, which Git ignores.
# These Supabase values identify the login service and are safe to share. Do not use a private administrator key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
AUTOPAY_CHAT_MODE=testing
# For a new database, create a 32-byte secret key encoded as base64 to protect bank details.
# Existing protected bank details need their original key; replacing it makes those records unreadable.
BANK_DATA_KEY=
# Optional email settings. For the live site, save these with wrangler secret put instead of committing them.
RESEND_API_KEY=
MAIL_FROM_EMAIL=
