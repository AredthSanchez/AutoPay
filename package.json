{
  "name": "autopay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.*",
    "deploy": "npm run build && node scripts/check-deployment.mjs && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "worker:check": "npm run build && wrangler deploy --dry-run --outdir .worker-build",
    "setup:check": "node scripts/check-deployment.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "^1.31.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@vitejs/plugin-react": "6.0.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}
